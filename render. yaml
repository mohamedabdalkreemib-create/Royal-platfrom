services:
  # 1. سيرفر الباكيند (FastAPI)
  - type: web
    name: royal-backend-api
    env: python
    buildCommand: pip install -r requirements.txt && python init_db.py
    startCommand: uvicorn main:app --host 0.0.0.0 --port $PORT
    envVars:
      - key: SECRET_KEY
        generateValue: true
      - key: ALGORITHM
        value: HS256
      - key: ALLOWED_ORIGINS
        value: "http://localhost:5173,http://127.0.0.1:5173"

  # 2. سيرفر الواجهة الأمامية (React Vite Static Site)
  - type: web
    name: royal-front-display
    env: static
    buildCommand: npm install && npm run build
    staticPublishPath: ./dist
    routes:
      - type: rewrite
        source: /*
        destination: /index.html
