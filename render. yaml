# 1. قسم الخدمات الخلفية السحابية (FastAPI Backend)
services:
  - type: web
    name: royal-backend-api
    env: python
    plan: free # تفعيل الخطة المجانية تماماً لمنع طلب الفيزا
    buildCommand: pip install -r requirements.txt
    startCommand: uvicorn main:app --host 0.0.0.0 --port $PORT
    envVars:
      - key: SECRET_KEY
        generateValue: true
      - key: ALGORITHM
        value: HS256
      - key: ALLOWED_ORIGINS
        value: "http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8000"

# 2. قسم المواقع الثابتة للواجهة الأمامية (React Static Site)
static_sites:
  - name: royal-front-display
    buildCommand: npm install && npm run build
    staticPublishPath: ./dist
    routes:
      - type: rewrite
        source: /*
        destination: /index.html
